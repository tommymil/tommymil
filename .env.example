# Konfiguracja uruchomienia przez docker compose.
# Skopiuj do `.env` obok docker-compose.yml i uzupełnij realnymi wartościami.
# Plik `.env` jest ignorowany przez git - NIE commituj go.

# --- Baza danych ---
# Domyślnie SQLite w wolumenie kontenera - zestaw migracji w repozytorium jest wygenerowany
# dla SQLite. Zostaw pusty, jeśli nie masz powodu tego zmieniać.
DB_CONNECTION_STRING=

# PostgreSQL - tylko z profilem `--profile postgres` i po wygenerowaniu migracji dla Npgsql.
# Wtedy ustaw również:
#   DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=lesson_runner;Username=lesson_runner;Password=...
POSTGRES_DB=lesson_runner
POSTGRES_USER=lesson_runner
POSTGRES_PASSWORD=zmien-to-na-dlugie-losowe-haslo

# --- Podpis tokenów JWT ---
# Minimum 32 bajty. Wygeneruj np.: openssl rand -base64 48
JWT_SIGNING_KEY=zmien-to-na-losowy-klucz-o-dlugosci-minimum-32-bajtow

# --- Pierwsze konto administratora ---
# Zakładane tylko przy pierwszym starcie, gdy w bazie nie ma aktywnego admina.
# Hasło zmień zaraz po pierwszym zalogowaniu (Mój profil -> zmiana hasła).
BOOTSTRAP_ADMIN_EMAIL=admin@twojadomena.pl
BOOTSTRAP_ADMIN_PASSWORD=zmien-to-przy-pierwszym-logowaniu

# --- Adresy ---
# Porty na hoście: strona ofertowa i system stoją w osobnych kontenerach.
WEB_PORT=8080
PANEL_PORT=8081
# Publiczny adres aplikacji - używany jako dozwolony origin CORS, gdy API stoi pod inną
# domeną, i jako wartość zapasowa dla obu adresów poniżej.
PUBLIC_ORIGIN=http://localhost:8080
# Adres strony ofertowej - stąd buduje się mapa strony (/sitemap.xml).
# Adres systemu - stąd buduje się link „ustaw hasło” w e-mailu, link do zgłoszenia w panelu
# i każdy inny adres, pod którym odbiorca ma się zalogować.
#
# Te dwie wartości trafiają w trzy miejsca naraz: do linków w e-mailach i mapy strony
# (backend), na listę dozwolonych originów CORS oraz do obu pakietów frontendu - stamtąd
# biorą się odnośniki prowadzące z jednej części do drugiej („Zaloguj się” na stronie,
# „Zobacz stronę” w panelu).
#
# Strona i panel są po rozdzieleniu **osobnymi aplikacjami**, więc pod jednym adresem nie
# da się już postawić obu. Przy wdrożeniu wypełnij oba, np.:
#   SITE_ORIGIN=https://zakodowani.pl
#   APP_ORIGIN=https://panel.zakodowani.pl
# Puste = odnośniki między nimi zostaną ścieżkami relatywnymi i nie dojdą na drugą stronę.
SITE_ORIGIN=
APP_ORIGIN=
# Adres API wbudowywany we frontend. Zostaw pusty - wtedy frontend używa ścieżek
# relatywnych, a nginx proxuje je do backendu (ten sam origin, bez CORS).
VITE_API_BASE_URL=

# --- Poczta ---
# Log = wysyłki tylko do logu aplikacji (bezpieczne do testów).
# Smtp = realna wysyłka. Przełącz dopiero, gdy szablony i lista odbiorców są sprawdzone.
SMTP_MODE=Log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true

# Nadawca wiadomości do rodziców - musi być realnym adresem w domenie, którą kontrolujesz.
# Wymagane: compose bez tej zmiennej celowo nie wstanie. Adresy z domen zarezerwowanych
# (.local, .test, .invalid, .example, example.com) są odrzucane, bo poczta z nich nie dojdzie.
# Wartość można później zmienić w panelu: Powiadomienia -> nadawca.
NOTIFICATIONS_FROM_EMAIL=zajecia@twojadomena.pl
NOTIFICATIONS_FROM_NAME=Szkoła Programowania

# --- Powiadomienia ---
# Co ile minut worker sprawdza nadchodzące zajęcia i wysyła przypomnienia.
REMINDER_INTERVAL_MINUTES=30
