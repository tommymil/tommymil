{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "LessonRunner",
    "Audience": "LessonRunnerClients",
    "SigningKey": "dev-only-signing-key-change-me-please-32+bytes-long",
    "ExpiryMinutes": 720
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5174"
    ]
  },
  "Backup": {
    "RootPath": "backups"
  },
  "Smtp": {
    "Mode": "Log"
  },
  "Notifications": {
    "ReminderIntervalMinutes": 30
  }
}
