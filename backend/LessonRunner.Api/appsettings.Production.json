    "RootPath": "/app/backups"
  },
  "Smtp": {
    "Mode": "Smtp",
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true
  },
  "Notifications": {
    "ReminderIntervalMinutes": 30
  }
}
