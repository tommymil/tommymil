{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=lesson-runner.db"
  },
  "Jwt": {
    "Issuer": "LessonRunner",
    "Audience": "LessonRunnerClients",
    "ExpiryMinutes": 720
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "App": {
    "PublicOrigin": "http://localhost:8080"
  },
  "Backup": {
    "RootPath": "backups"
  },
  "Smtp": {
    "Mode": "Log",
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true
  },
  "Notifications": {
    "ReminderIntervalMinutes": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
